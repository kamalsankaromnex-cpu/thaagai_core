# ==============================================================================
# THAAGAI - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production and fill in with authoritative production secrets.

# 1. Database (Supabase PostgreSQL Connection Pooler)
# Use transaction mode on port 6543 or session mode on port 5432
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Production Domain
SITE_URL="https://thaagai.com"
NEXT_PUBLIC_SITE_URL="https://thaagai.com"

# 3. Security & Authentication (Required in Production: Minimum 32 random characters)
# Generate via: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_AT_LEAST_32_CHAR_CRYPTO_RANDOM_SECRET_KEY"

# 4. Initial Root Administrator (Used for bootstrap seeding)
ADMIN_EMAIL="owner@thaagai.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD"

# 5. WhatsApp Business Integration
# E.164 country code format without plus or spaces (e.g. 919876543210 for India +91)
WHATSAPP_BUSINESS_NUMBER="919876543210"

# 6. Object Storage Driver
# 'local' for self-hosted uploads or 's3' for Supabase Storage / AWS S3
STORAGE_DRIVER="local"
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
