generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_WHATSAPP
  PENDING_WHATSAPP_CONFIRMATION
  SUBMITTED_BY_CUSTOMER
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MovementType {
  MANUAL_ADJUSTMENT
  ORDER_CONFIRMED
  ORDER_CANCELLED
  RESTOCK
}

model AdminUser {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  role         Role                 @default(ADMIN)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  movements    InventoryMovement[]
  history      OrderStatusHistory[]
  financeTransactions FinanceTransaction[]
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  imageUrl       String?
  bannerKey      String?
  bannerAlt      String?
  parentId       String?
  parent         Category?         @relation("Tree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]        @relation("Tree")
  sortOrder      Int               @default(0)
  active         Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noindex        Boolean           @default(false)
  products       ProductCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ProductType {
  READY_TO_WEAR
  CUSTOM_MADE
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  shortDescription    String?
  description         String?
  productType         ProductType          @default(READY_TO_WEAR)
  basePrice           Decimal              @db.Decimal(10, 2)
  salePrice           Decimal?             @db.Decimal(10, 2)
  sku                 String?              @unique
  status              ProductStatus        @default(DRAFT)
  featured            Boolean              @default(false)
  fabricCare          String?
  shippingInfo        String?
  publishedAt         DateTime?
  archivedAt          DateTime?
  seoTitle            String?
  seoDescription      String?
  canonicalUrl        String?
  noindex             Boolean              @default(false)
  variants            ProductVariant[]
  images              ProductImage[]
  categories          ProductCategory[]
  customizationGroups CustomizationGroup[]
  reviews             Review[]
  sizeCharts          SizeChart[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, publishedAt])
}

model CustomizationGroup {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      String                @default("SELECT")
  required  Boolean               @default(true)
  sortOrder Int                   @default(0)
  active    Boolean               @default(true)
  options   CustomizationOption[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId])
}

model CustomizationOption {
  id          String             @id @default(cuid())
  groupId     String
  group       CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal            @default(0) @db.Decimal(10, 2)
  description String?
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)

  @@index([groupId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
}

model ProductVariant {
  id                String              @id @default(cuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String              @unique
  size              String?
  colour            String?
  attributes        Json?
  priceOverride     Decimal?            @db.Decimal(10, 2)
  salePriceOverride Decimal?            @db.Decimal(10, 2)
  stockQuantity     Int                 @default(0)
  lowStockThreshold Int                 @default(2)
  active            Boolean             @default(true)
  images            ProductImage[]
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([productId])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storageKey String
  altText    String
  sortOrder  Int             @default(0)
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())
}

model OrderRequest {
  id                  String               @id @default(cuid())
  reference           String               @unique
  customerId          String?
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String
  customerPhone       String
  address             String
  city                String
  state               String
  pinCode             String
  deliverySnapshot    Json?
  subtotal            Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  shippingAmount      Decimal?             @db.Decimal(10, 2)
  taxAmount           Decimal?             @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  currency            String               @default("INR")
  status              OrderStatus          @default(PENDING_WHATSAPP)
  paymentStatus       PaymentStatus        @default(UNPAID)
  consentAt           DateTime
  whatsappInitiatedAt DateTime?
  customerReportedAt  DateTime?
  confirmedAt         DateTime?
  internalNotes       String?
  courier             String?
  trackingNumber      String?
  shippedAt           DateTime?
  idempotencyKey      String?              @unique
  items               OrderItem[]
  history             OrderStatusHistory[]
  reviews             Review[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerId])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  order          OrderRequest @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  variantId      String?
  productName    String
  sku            String?
  variantLabel   String?
  unitPrice      Decimal      @db.Decimal(10, 2)
  quantity       Int
  lineTotal      Decimal      @db.Decimal(10, 2)
  customizations Json?
}

model OrderStatusHistory {
  id             String        @id @default(cuid())
  orderId        String
  order          OrderRequest  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  actorId        String?
  actor          AdminUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime      @default(now())
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type      MovementType
  delta     Int
  reason    String
  refType   String?
  refId     String?
  actorId   String?
  actor     AdminUser?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([variantId, createdAt])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  status          Int      @default(301)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Customer {
  id               String            @id @default(cuid())
  mobileNumber     String            @unique
  mobileVerifiedAt DateTime?
  fullName         String?
  email            String?
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  addresses        CustomerAddress[]
  orders           OrderRequest[]
  reviews          Review[]

  @@index([mobileNumber])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String
  mobileNumber  String
  houseOrFlat   String
  buildingName  String?
  street        String
  locality      String
  landmark      String?
  pinCode       String
  postOffice    String?
  city          String
  district      String
  state         String
  country       String   @default("India")
  addressType   String   @default("HOME")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

model OtpVerification {
  id           String   @id @default(cuid())
  mobileNumber String
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([mobileNumber, createdAt])
}

model HeroSlide {
  id                String    @id @default(cuid())
  eyebrow           String?
  title             String
  description       String
  primaryCtaLabel   String
  primaryCtaUrl     String
  secondaryCtaLabel String?
  secondaryCtaUrl   String?
  desktopImage      String
  mobileImage       String?
  altText           String
  textAlignment     String    @default("left") // "left" | "center" | "right"
  overlayOpacity    Int       @default(40)     // percentage, e.g. 40
  sortOrder         Int       @default(0)
  active            Boolean   @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, sortOrder])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  FLAGGED
}

model Review {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId          String?
  order            OrderRequest? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String?
  customerPhone    String?
  rating           Int           // 1 to 5
  title            String
  content          String
  images           String[]      @default([]) // URLs of customer photos
  status           ReviewStatus  @default(PENDING)
  verifiedPurchase Boolean       @default(false)
  adminNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([productId, status, createdAt])
  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model SizeChart {
  id             String    @id @default(cuid())
  name           String
  categorySlug   String?   // applies to category default e.g. "straight-cut-churidars"
  productId      String?   // optional product-specific override
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  gender         String    @default("WOMEN")
  measurements   Json      // { sizes: ["XS", "S", "M", "L", "XL", "XXL"], rows: [...] }
  howToMeasure   Json?     // [{ part: "Bust", instruction: "..." }]
  customFitGuide String?   // bespoke advice
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([categorySlug])
  @@index([productId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String
  message   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}

enum FinanceType {
  INCOME
  EXPENSE
}

model FinanceTransaction {
  id              String      @id @default(cuid())
  type            FinanceType
  category        String      // "SALES_REVENUE", "FABRIC_SOURCING", "PACKAGING", "LOGISTICS", "MARKETING", "STUDIO_RENT", "TAILORING_WAGES", "MISCELLANEOUS"
  amount          Decimal     @db.Decimal(10, 2)
  paymentMethod   String      @default("BANK_TRANSFER") // "UPI", "BANK_TRANSFER", "CASH", "CARD"
  referenceType   String?     // "ORDER", "PURCHASE_ORDER", "OPERATING_EXPENSE", "REFUND"
  referenceId     String?     // order ID or PO ID
  description     String
  receiptUrl      String?
  status          String      @default("COMPLETED") // "PENDING", "COMPLETED", "REVERSED"
  transactionDate DateTime    @default(now())
  actorId         String?
  actor           AdminUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  idempotencyKey  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([type, transactionDate])
  @@index([category])
  @@index([referenceType, referenceId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  gstin          String?
  active         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  poNumber       String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  subtotal       Decimal             @db.Decimal(10, 2)
  taxAmount      Decimal?            @db.Decimal(10, 2)
  shippingAmount Decimal?            @db.Decimal(10, 2)
  totalAmount    Decimal             @db.Decimal(10, 2)
  notes          String?
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  poId             String
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  variantId        String?
  sku              String?
  productName      String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(10, 2)
  lineTotal        Decimal       @db.Decimal(10, 2)
}

model GoodsReceipt {
  id            String             @id @default(cuid())
  receiptNumber String             @unique
  poId          String
  po            PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  receivedDate  DateTime           @default(now())
  receivedBy    String?
  invoiceNumber String?
  notes         String?
  items         GoodsReceiptItem[]
  createdAt     DateTime           @default(now())
}

model GoodsReceiptItem {
  id               String       @id @default(cuid())
  receiptId        String
  receipt          GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poItemId         String?
  variantId        String?
  quantityAccepted Int
  quantityDamaged  Int          @default(0)
  unitCost         Decimal      @db.Decimal(10, 2)
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id                String       @id @default(cuid())
  code              String       @unique
  title             String
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?
  timesUsed         Int          @default(0)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([code, active])
}

